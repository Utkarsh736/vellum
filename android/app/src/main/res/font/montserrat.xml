<?xml version="1.0" encoding="utf-8"?>
<!-- Font families (Paper Design): Montserrat display + PT Mono.
     Roboto is the Android system default and needs no resource. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/montserrat_500" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/montserrat_600" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/montserrat_700" />
</font-family>
